@ApiService_HostAddress = http://localhost:5384

### Get all products
GET {{ApiService_HostAddress}}/api/products
Accept: application/json

### Get product by ID
GET {{ApiService_HostAddress}}/api/products/1
Accept: application/json

### Create a new product
POST {{ApiService_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Wireless Mouse",
  "description": "Ergonomic wireless mouse with silent clicks and 12-month battery life.",
  "price": 34.99,
  "imageUrl": "https://example.com/images/mouse.jpg"
}

### Update an existing product
PUT {{ApiService_HostAddress}}/api/products/1
Content-Type: application/json

{
  "name": "Wireless Noise-Cancelling Headphones (2nd Gen)",
  "description": "Over-ear Bluetooth headphones with 40-hour battery life and adaptive noise cancellation.",
  "price": 229.99,
  "imageUrl": "https://example.com/images/headphones-v2.jpg"
}

### Delete a product
DELETE {{ApiService_HostAddress}}/api/products/5

@CustomerId = 3f2504e0-4f89-11d3-9a0c-0305e82c3301

### Get all customers
GET {{ApiService_HostAddress}}/api/customers
Accept: application/json

### Get customer by ID
GET {{ApiService_HostAddress}}/api/customers/{{CustomerId}}
Accept: application/json

### Create a new customer
POST {{ApiService_HostAddress}}/api/customers
Content-Type: application/json

{
  "name": "Carol Wanjiru",
  "email": "carol.wanjiru@example.com"
}

### Update an existing customer
PUT {{ApiService_HostAddress}}/api/customers/{{CustomerId}}
Content-Type: application/json

{
  "name": "Carol Wanjiru",
  "email": "carol.w@example.com"
}

### Delete a customer
DELETE {{ApiService_HostAddress}}/api/customers/{{CustomerId}}

### Get all orders
GET {{ApiService_HostAddress}}/api/orders
Accept: application/json

### Get order by ID
GET {{ApiService_HostAddress}}/api/orders/1
Accept: application/json

### Create a new order
POST {{ApiService_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerName": "Carol Wanjiru",
  "status": "Pending",
  "items": [
    { "productId": 3, "productName": "4K Webcam", "quantity": 1, "unitPrice": 129.00 },
    { "productId": 2, "productName": "Mechanical Keyboard", "quantity": 2, "unitPrice": 89.50 }
  ]
}

### Update an existing order
PUT {{ApiService_HostAddress}}/api/orders/2
Content-Type: application/json

{
  "customerName": "Brian Otieno",
  "status": "Paid",
  "items": [
    { "productId": 2, "productName": "Mechanical Keyboard", "quantity": 1, "unitPrice": 89.50 }
  ]
}

### Delete an order
DELETE {{ApiService_HostAddress}}/api/orders/1

@CartId = 3f2504e0-4f89-11d3-9a0c-0305e82c3301

### Get (or create) a cart
GET {{ApiService_HostAddress}}/api/carts/{{CartId}}
Accept: application/json

### Add an item to the cart
POST {{ApiService_HostAddress}}/api/carts/{{CartId}}/items
Content-Type: application/json

{
  "productId": 2,
  "quantity": 1
}

### Remove an item from the cart
DELETE {{ApiService_HostAddress}}/api/carts/{{CartId}}/items/2

### Checkout the cart (creates an order and clears the cart)
POST {{ApiService_HostAddress}}/api/carts/{{CartId}}/checkout
Content-Type: application/json

{
  "customerName": "Carol Wanjiru"
}